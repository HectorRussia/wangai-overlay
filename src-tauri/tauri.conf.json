{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLingo",
  "version": "0.1.0",
  "identifier": "dev.gamelingo.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameLingo",
        "url": "index.html?view=settings",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "GameLingo Overlay",
        "url": "index.html?view=overlay",
        "width": 920,
        "height": 240,
        "x": 500,
        "y": 760,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../worker/**/*",
      "../scripts/**/*"
    ]
  }
}

