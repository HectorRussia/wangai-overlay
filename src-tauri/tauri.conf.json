{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WANGAI",
  "version": "0.3.0",
  "identifier": "dev.gamelingo.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WANGAI",
        "url": "index.html#/settings/overview",
        "width": 820,
        "height": 480,
        "minWidth": 720,
        "minHeight": 410,
        "center": true,
        "visible": true,
        "focus": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "create": false,
        "title": "WANGAI Overlay",
        "url": "index.html#/overlay",
        "width": 420,
        "height": 236,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "web/"
    }
  }
}
