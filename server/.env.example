# Deployment configuration only. Never include real credentials in images or source control.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=replace-on-server
STT_INCOMING_MODEL=whisper-large-v3
STT_MICROPHONE_MODEL=whisper-large-v3-turbo

TRANSLATION_BASE_URL=https://api.x.ai/v1
TRANSLATION_API_KEY=replace-on-server
# Choose a model supported by the configured provider's Chat Completions endpoint.
TRANSLATION_MODEL=replace-with-compatible-model-id
# Optional validated provider-specific fields. Empty by default for interoperability.
# Example for a supporting provider/model: {"max_completion_tokens":512,"reasoning_effort":"low","include_reasoning":false}
TRANSLATION_OPTIONS_JSON={}

BIND_ADDRESS=0.0.0.0:8080
DATABASE_PATH=/data/usage.sqlite3
MAX_CONCURRENT_REQUESTS=32
UPSTREAM_TIMEOUT_SECONDS=15
